# Kopieer dit bestand naar .env voor lokaal testen (npm run dev).
# Op Vercel zet je dezelfde namen onder Settings, Environment Variables.

# Wachtwoord voor /admin (gebruikersnaam mag alles zijn)
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# Database (Turso). Laat leeg om lokaal een SQLite-bestand te gebruiken.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Geheim voor /api/cron/sync (alleen nodig voor de optionele GitHub-taak)
CRON_SECRET=
